# Environment template. Copy to .env.local (gitignored), fill in real
# values, then `make run` (or `make run ENV_FILE=<file>`).
# AccessKey（在 https://ram.console.aliyun.com/users 创建 RAM 用户得到）
ALIYUN_ACCESS_KEY_ID=LTAI....
ALIYUN_ACCESS_KEY_SECRET=...

# NLS 项目 AppKey（在 https://nls-portal.console.aliyun.com 项目列表里查）
ALIYUN_NLS_APPKEY=your-nls-appkey-here

# NLS 区域（支持 cn-shanghai / cn-beijing / cn-shenzhen）
ALIYUN_NLS_REGION=cn-shanghai

# ─── TTS 默认参数（可改）───
# 发音人：siyue / xiaoyun / xiaogang / Aida（女童） / 详见 https://help.aliyun.com/document_detail/84435.html
TTS_VOICE=siyue
# 采样率：8000 / 16000 / 24000
TTS_SAMPLE_RATE=16000
# 音量：0~100，默认 50
TTS_VOLUME=50
# 语速：-500~500，默认 0
TTS_SPEECH_RATE=0

# ─── LLM（内核 llm.chat RPC） ───
# provider: deepseek | openai | openai_compat | （留空 = 禁用）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat
# 自定义 OpenAI 兼容端点时填写（deepseek/openai 有内置默认值）
# LLM_BASE_URL=https://api.deepseek.com/v1
LLM_SYSTEM_PROMPT=你是 flowkit 智能语音助手，请用简洁、口语化的中文回答（每次回复不要超过 80 字）。

# ─── RPC 监听与鉴权 ───
# 默认只监听本机。对外监听（如 0.0.0.0:9600）时必须设置 FLOWKIT_API_KEY，
# 客户端在 /ws 和 /media/pcm 握手时带 "Authorization: Bearer <key>"。
# 生成：openssl rand -hex 32
RPC_LISTEN=127.0.0.1:9600
FLOWKIT_API_KEY=
# 仅在所有对端都可信的内网里使用：对外监听但不鉴权
# FLOWKIT_ALLOW_INSECURE_NO_AUTH=false

# RPC 参数里的回调/下载地址（turn_url、audio_url、ws_url）允许的域名，逗号分隔；
# ".example.com" 匹配所有子域名。留空 = 不限制
FLOWKIT_OUTBOUND_URL_ALLOWED_HOSTS=

# ─── ⭐ Phase 8 内核可观测 + 分布式 ───
# 监听地址（默认 :8080）
LISTEN_ADDR=:8080

# SIGTERM 优雅关闭等待秒数（k8s 默认 terminationGracePeriodSeconds=30 配合）
SHUTDOWN_GRACE_SECONDS=30

# OTLP 后端配置（标准 OpenTelemetry 环境变量）——
# 不配置 = 不上报，仅 stderr 日志（本地开发就这样）
# 配置示例（接你的 OTLP 后端）：
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logs.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <your-base64-credentials>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=flowkit-kernel
# Backend-specific routing headers (e.g. GreptimeDB). Sent only to the matching
# endpoint—pipeline to traces, table-name to logs—so they never cross:
# OTEL_TRACES_PIPELINE_NAME=<your-traces-pipeline>
# OTEL_LOGS_TABLE_NAME=otel_logs
# DEPLOY_ENV=production

# 实例标识（多副本部署时用）——
# k8s 推荐用 metadata.name 注入 pod 名:
#   env: [{name: INSTANCE_ID, valueFrom: {fieldRef: {fieldPath: metadata.name}}}]
# INSTANCE_ID=flowkit-pod-1
# INSTANCE_URL=http://203.0.113.50:9600   # 公网 IP，hello + WebRTC ICE 用；勿用 127.0.0.1
# WEBRTC_PUBLIC_IP=203.0.113.50           # 可选；未设时从 INSTANCE_URL 主机名推导

# ─── M3c SIP Trunk（购买后填，未购买保持空白）────────
# vendor: aliyun | tencent | twilio | signalwire | zadarma
SIP_TRUNK_VENDOR=
SIP_TRUNK_SERVER=                 # 例：sip.zadarma.com / trunk.aliyun.com / xxx.pstn.twilio.com
SIP_TRUNK_PORT=5060
SIP_TRUNK_TRANSPORT=UDP           # UDP | TCP | TLS
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=               # 运营商若为纯 IP 信任（白名单 SIP_TRUNK_SERVER）可留空；要求 401 鉴权则必填
# SIP_TRUNK_AUTH_USER=            # 已废弃：当前 flowkit.yaml 未接，写了不生效
SIP_TRUNK_REALM=                  # 一般留空，由 401 challenge 推断
SIP_TRUNK_DID=                    # 你购买的号码，E.164 格式 +8613...

# ─── SIP 外呼 Trunk（可选，仅当外呼网关与入站不同 / 凭证不同时填）────────
# 留空 → 自动 fallback 到上面入站 SIP_TRUNK_* 字段
SIP_TRUNK_OUTBOUND_SERVER=        # 外呼上联网关 IP/域名（与入站不同时填）
SIP_TRUNK_OUTBOUND_PORT=5060
SIP_TRUNK_OUTBOUND_USERNAME=      # 外呼网关单独的鉴权账号；上联为 IP 白名单可留空。留空时 fallback SIP_TRUNK_USERNAME（通常不对）
SIP_TRUNK_OUTBOUND_PASSWORD=      # 同上
SIP_TRUNK_OUTBOUND_REALM=         # 一般留空，401 challenge 推断
SIP_TRUNK_OUTBOUND_DID=           # 外呼主叫号（caller_id 兜底），与入站 DID 不同时填
SIP_TRUNK_OUTBOUND_CALLEE_PREFIX= # 出局接入码（俗称"组号/线路码"，如 035 / 9 / 17951）。运营商要求才填，否则永远拨不通；不要时务必留空
SIP_ALLOW_ORIGINATE=false         # 是否允许 call.originate 外呼，默认关闭

SIP_LISTEN_ADDR=0.0.0.0:5060      # 本机 SIP UA 监听；留空 = SIP 完全不启动
SIP_EXT_IP=auto                   # 公网 IP，auto = 自动探测，K8s 内填 LB IP
# 可选：system.hello 给 Explorer 的首次默认下拉值，不写死运行时编排（随时可切换）
SIP_INBOUND_MODE=notify
# 内核自动 SIP→LLM（无浏览器）；与客户端灵活编排互斥，需要 AI 接待+转人工时建议 false
SIP_KERNEL_AUTO_LLM=false
# llm 模式下可选开场白（空 = 默认「您好，请问有什么可以帮您？」）
# SIP_LLM_GREETING=您好，欢迎致电。
# 打断（barge-in）：partial 至少几个字才触发（0 = 任意非空 partial 即可）
SIP_LLM_BARGE_IN_MIN_CHARS=2
# 是否在 speech_start（VAD）时也打断；易误触，默认 false
# SIP_LLM_BARGE_IN_ON_START=false
# 自适应打断：VAD 起音时的动作。none=只观察不动播放（新默认，噪音/附和不再造成卡顿），
# duck/pause=起音就降音量/暂停（回退旧行为）
SIP_LLM_BARGE_ONSET_ACTION=none
# 自适应打断候选期是否降音量；false=从不降音量，原本降音量的时机直接静音（可续播）
SIP_LLM_BARGE_DUCK=true
# yielded（无损暂停）后等不到有效 final 的断点续播超时（毫秒）
SIP_LLM_BARGE_FALSE_INTERRUPT_MS=2000
# 假打断是否从原位置续播；false 则保持停止（等价确认打断）
SIP_LLM_BARGE_RESUME_FALSE_INTERRUPT=true

# ─── SIP 入站通话生命周期 ───
# 无入站 RTP 超过该时长视为断线，自动挂断并释放入站资源（防僵尸会话占线）
SIP_RTP_IDLE_TIMEOUT=60s
# 单路入站最长通话时长，超时强制挂断
SIP_INBOUND_MAX_DURATION=4h
# 同时进线并发上限；0 = 不限制。可按机器资源设上限，例：20
SIP_MAX_INBOUND_CALLS=0

# 空闲时按 20ms 节拍持续发 G.711 静音保活 RTP（默认开）。运营商 SBC/手机端把断流
# 当作 VAD/DTX 状态切换并复位抖动缓冲，恢复播出的音频会被听成卡顿；置 0 回退旧行为
SIP_IDLE_KEEPALIVE=1

# ─── 多 SIP Trunk Catalog ────────
# 默认：static=true（env 装载成内置 system Provider）, register=false（不开 HTTP 注册 API）
# 单 trunk 部署完全不改 env 即可继续工作。
TELECOM_STATIC_ENABLED=true
# 打开后，CC 可通过 PUT /api/v1/telecom/registrars/{id}/snapshot 动态注册多 Trunk
TELECOM_REGISTER_ENABLED=false
# 必填（register 打开时）：CC 调注册 API 必须带 X-API-Key 头
FLOWKIT_TELECOM_API_KEY=
# 入站源 IP 不在任何 Trunk peer 列表里（也不是已注册分机）时，默认 403（true）；
# 改 false 则接受任意来源
TELECOM_REJECT_UNKNOWN_PEER=true
# call.incoming.to 归一化：e164_strip_prefix = 去 +/tel:/visual sep；空 = 关闭
TELECOM_TO_NORMALIZATION=e164_strip_prefix

# ─── 通话录音 ────────────────
RECORDING_ENABLED=false
RECORDING_START_ON=answered          # answered | ringing
RECORDING_ENCODING=pcm16             # v0.1: pcm16 only
RECORDING_LAYOUT=stereo              # stereo | mono_mix（拼写错误将启动失败）
RECORDING_MAX_DURATION=4h
RECORDING_FLUSH_INTERVAL=4s

# ─── 桥接实时转写 ────────────────
# 坐席接通（bridge）后对用户腿和坐席腿各跑一路 ASR，推 call.bridge_transcript
# {speaker,text,final} 供 CC 端实时展示对话。默认关；需已配置 ASR_PROVIDER。
BRIDGE_ASR_ENABLED=false
# 转写端点静音(ms)：转写按整句切，故比 IVR 的 ASR_ENDPOINT_SILENCE_MS(200) 长。
# 仅 custom(FunASR) 生效；同时强制 chunk_size=5,10,5（原生 2pass）。默认 800。
BRIDGE_ASR_ENDPOINT_SILENCE_MS=800
RECORDING_STORAGE_BACKEND=aliyun_oss # aliyun_oss | local
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY=                      # 空则回退 ALIYUN_ACCESS_KEY_ID
OSS_ACCESS_SECRET=                   # 空则回退 ALIYUN_ACCESS_KEY_SECRET
OSS_SSE=true
# 本地调试可用相对路径，例如 ./tmp/recordings（生产默认需 deploy 创建目录并 chown）
RECORDING_LOCAL_DIR=/var/lib/flowkit/recordings

# ─── M4 多节点 Redis（M1-M3 不需要）─────────────────
REDIS_ADDR=                        # 例：localhost:6379；空 = 单节点 LocalStore
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ─── 节点身份（M4 多节点必填）─────────────────────
NODE_ID=                           # 唯一节点 ID，例：flowkit-1
NODE_ADDR=                         # 其他节点可达地址，例：flowkit-1:9600
